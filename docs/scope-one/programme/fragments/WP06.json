  "tasks": [
    {
      "id": "WP06-01",
      "title": "Acceptance state model: received, replicated, evaluated, accepted, rejected, superseded; transitions and who may make them",
      "phase": "design",
      "owner": "lane-core",
      "depends_on": [
        "WP04-01",
        "WP07-02"
      ],
      "requirements": [
        "MV-ARCH-06"
      ],
      "description": "Repo: memev. Resolves ADR 4 (policy defaults) for acceptance.",
      "scope": {
        "allow": [
          "docs/ACCEPTANCE.md"
        ]
      },
      "criteria": [
        {
          "id": "WP06-01-AC01",
          "mandatory": true,
          "statement": "doc exists",
          "verifier": {
            "type": "file_exists",
            "path": "docs/ACCEPTANCE.md"
          }
        },
        {
          "id": "WP06-01-AC02",
          "mandatory": true,
          "statement": "doc names replicated is not accepted",
          "verifier": {
            "type": "grep",
            "file": "docs/ACCEPTANCE.md",
            "pattern": "(?i)replicat.*not.*accept",
            "must": "present"
          }
        },
        {
          "id": "WP06-01-AC03",
          "mandatory": true,
          "statement": "Changes stay in scope",
          "verifier": {
            "type": "scope"
          }
        },
        {
          "id": "WP06-01-AC04",
          "mandatory": true,
          "statement": "Committed and pushed to main",
          "verifier": {
            "type": "pushed"
          }
        }
      ],
      "stop_rules": [
        "No weakening of an existing test, no raised timeout, no skip, no widened scope; if blocked, report what blocks and continue with the next independent task."
      ]
    },
    {
      "id": "WP06-02",
