        "allow": [
          "docs/scope-one/INVENTORY.md",
          "docs/scope-one/REGISTER-REFRESH.md",
          "test/**"
        ]
      },
      "criteria": [
        {
          "id": "WP17-01-AC01",
          "mandatory": true,
          "statement": "inventory no longer says 27 open draft PRs",
          "verifier": {
            "type": "grep",
            "file": "docs/scope-one/INVENTORY.md",
            "pattern": "27 open draft pull requests",
            "must": "absent"
