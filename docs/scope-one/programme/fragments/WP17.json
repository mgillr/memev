          }
        },
        {
          "id": "WP17-01-AC03",
          "mandatory": true,
          "statement": "Changes stay in scope",
          "verifier": {
            "type": "scope"
          }
        },
        {
          "id": "WP17-01-AC04",
          "mandatory": true,
          "statement": "Committed and pushed to main",
          "verifier": {
            "type": "pushed"
          }
        }
      ],
      "stop_rules": [
        "No weakening of an existing test, no raised timeout, no skip, no widened scope; if blocked, report what blocks and continue with the next independent task."
      ]
