      "description": "Repo: memev. Fields from the notes: origin identity and node, operation id, causal dependencies, project and object id, type and payload, authorisation evidence, contract or policy reference, content hash, verification status. Resolve ADR 2 (id and event ordering) in the same change.",
      "scope": {
        "allow": [
          "docs/OPERATION-ENVELOPE.md"
        ]
      },
      "criteria": [
        {
          "id": "WP04-01-AC01",
          "mandatory": true,
          "statement": "spec exists",
          "verifier": {
            "type": "file_exists",
            "path": "docs/OPERATION-ENVELOPE.md"
          }
        },
        {
          "id": "WP04-01-AC02",
          "mandatory": true,
          "statement": "spec names the verification status field",
          "verifier": {
            "type": "grep",
            "file": "docs/OPERATION-ENVELOPE.md",
            "pattern": "verification_status",
            "must": "present"
          }
        },
        {
          "id": "WP04-01-AC03",
          "mandatory": true,
          "statement": "Changes stay in scope",
          "verifier": {
            "type": "scope"
          }
        },
        {
          "id": "WP04-01-AC04",
          "mandatory": true,
          "statement": "Committed and pushed to main",
          "verifier": {
            "type": "pushed"
          }
        }
      ],
      "stop_rules": [
