    {
      "id": "WP10-01",
      "title": "Knowledge status lattice: own observation, single-source claim, corroborated, verified, approved decision, disputed, superseded; transition rules",
      "phase": "design",
      "owner": "lane-trust",
      "depends_on": [
        "WP04-01"
      ],
      "requirements": [
        "MV-ARCH-08",
        "MV-TRU-03"
      ],
      "description": "Repo: mgillr/memev. Records the distinctions (replicated is not verified; signed is not true; converged is not completed; trust is not access control; payment receipt is not delivery).",
      "scope": {
        "allow": [
          "docs/KNOWLEDGE-STATUS.md"
        ]
      },
      "criteria": [
        {
          "id": "WP10-01-AC01",
          "mandatory": true,
          "statement": "doc exists",
          "verifier": {
            "type": "file_exists",
            "path": "docs/KNOWLEDGE-STATUS.md"
          }
        },
        {
          "id": "WP10-01-AC02",
          "mandatory": true,
          "statement": "doc says repetition does not raise a disputed claim",
          "verifier": {
            "type": "grep",
            "file": "docs/KNOWLEDGE-STATUS.md",
            "pattern": "(?i)repetition",
            "must": "present"
          }
        },
        {
          "id": "WP10-01-AC03",
          "mandatory": true,
          "statement": "Changes stay in scope",
          "verifier": {
            "type": "scope"
          }
        },
        {
          "id": "WP10-01-AC04",
          "mandatory": true,
          "statement": "Committed and pushed to main",
          "verifier": {
            "type": "pushed"
          }
        }
      ],
      "stop_rules": [
        "No weakening of an existing test, no raised timeout, no skip, no widened scope; if blocked, report what blocks and continue with the next independent task."
      ]
    },
